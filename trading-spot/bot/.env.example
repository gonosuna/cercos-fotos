# Copiá este archivo como ".env" y completalo. NUNCA lo subas a GitHub ni lo compartas.
# Claves de la TESTNET (https://testnet.binance.vision, ingresando con GitHub -> "Generate HMAC-SHA-256 Key")
TESTNET_API_KEY=
TESTNET_API_SECRET=
# Claves REALES (solo mas adelante; SIN permiso de retiros)
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Telegram: token que te da @BotFather. El chat id lo da el bot cuando le mandas /start
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Planilla: URL de la implementacion web del Apps Script y el mismo secreto que pongas en el script
SHEETS_URL=
SHEETS_SECRET=
